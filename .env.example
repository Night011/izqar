# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
IZQAR_API_KEY=CHANGE_ME_TO_RANDOM_32_CHARS
# Run from backend/: default local SQLite; Docker Compose overrides to PostgreSQL.
DATABASE_URL=sqlite:///./izqar.db
IZQAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_PASSWORD=CHANGE_ME_TO_RANDOM_POSTGRES_PASSWORD
# Optional after a trusted BAF Base Kaggle final run:
# IZQAR_BAF_MODEL_PATH=C:\path\to\IZQAR-MVP\backend\models\baf_base_v1_portable.metrics.json
